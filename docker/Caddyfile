{
	frankenphp
	auto_https off
}

:{$PORT} {
	root {$APP_ROOT:/app/public}
	encode zstd br gzip

	# Answer the liveness probe without consuming a PHP thread — long-lived
	# subscriptions/listen streams can otherwise occupy every thread and
	# starve /up into proxy 503s.
	respond /up "Application up" 200

	php_server {
		try_files {path} index.php
	}
}
